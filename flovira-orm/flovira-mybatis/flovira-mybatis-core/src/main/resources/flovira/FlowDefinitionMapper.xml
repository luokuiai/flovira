        flow_code,
        flow_name,
        category,
        version,
        publish_status,
        form_custom,
        form_path,
        activity_status,
        listener_type,
        listener_path,
        ext,
        created_at,
        updated_at,
        deleted,
        tenant_id,
        created_by,
        updated_by
        )
        <foreach collection="list" item="item" separator=" union all">
            select
            #{item.id},
            #{item.flowCode},
            #{item.flowName},
            #{item.category},
            #{item.version},
            #{item.publishStatus},
            #{item.formCustom},
            #{item.formPath},
            #{item.activityStatus},
            #{item.listenerType},
            #{item.listenerPath},
            #{item.ext},
            #{item.createdAt},
            #{item.updatedAt},
            #{item.deleted},
            #{item.tenantId},
            #{item.createdBy},
            #{item.updatedBy}
