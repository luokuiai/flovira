<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luokuiai.flovira.orm.mapper.FlowFormMapper">
    <resultMap type="com.luokuiai.flovira.orm.entity.FlowForm" id="FlowFormResult">
        <result property="id" column="id"/>
        <result property="formCode" column="form_code"/>
        <result property="formName" column="form_name"/>
        <result property="version" column="version"/>
        <result property="publishStatus" column="publish_status"/>
        <result property="formContent" column="form_content"/>
        <result property="ext" column="ext"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deleted" column="deleted"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>

    <sql id="selectVo">
        select t.id,
        t.form_code,
        t.form_name,
        t.version,
        t.publish_status,
        t.form_content,
        t.ext,
        t.created_at,
        t.updated_at,
        t.deleted,
        t.tenant_id,
        t.created_by,
        t.updated_by
        from flow_form t
    </sql>

    <sql id="paging_end">
        <if test="page !=null and page.pageNum != null and page.pageSize != null">LIMIT
            #{page.pageSize} offset #{page.pageNum}
        </if>
    </sql>

    <sql id="order_by">
        <if test="order != null and order != ''">order by ${order}</if>
    </sql>

    <sql id="select_parameter">
        <where>
            <if test="entity.id != null ">and t.id = #{entity.id}</if>
            <if test="entity.formCode != null  and entity.formCode != ''">and t.form_code = #{entity.formCode}</if>
            <if test="entity.formName != null  and entity.formName != ''">and t.form_name = #{entity.formName}</if>
            <if test="entity.version != null  and entity.version != ''">and t.version = #{entity.version}</if>
            <if test="entity.publishStatus != null ">and t.publish_status = #{entity.publishStatus}</if>
            <if test="entity.formContent != null">and t.form_content = #{entity.formContent}</if>
            <if test="entity.ext != null  and entity.ext != ''">and t.ext = #{entity.ext}</if>
            <if test="entity.createdAt != null">and t.created_at = #{entity.createdAt}</if>
            <if test="entity.updatedAt != null">and t.updated_at = #{entity.updatedAt}</if>
            <if test="entity.deleted != null  and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
            <if test="entity.tenantId != null  and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
            <if test="entity.updatedBy != null and entity.updatedBy != ''">and t.updated_by = #{entity.updatedBy}</if>
            <if test="entity.createdBy != null and entity.createdBy != ''"> and t.created_by = #{entity.createdBy}</if>
        </where>
    </sql>

    <sql id="mysql_insert_batch">
        insert into flow_form(
        id,
        form_code,
        form_name,
        version,
        publish_status,
        form_content,
        ext,
        created_at,
        updated_at,
        deleted,
        tenant_id,
        created_by,
        updated_by
        )
        values
        <foreach collection="list" item="item" separator=",">
            (
            #{item.id},
            #{item.formCode},
            #{item.formName},
            #{item.version},
            #{item.publishStatus},
            #{item.formContent},
            #{item.ext},
            #{item.createdAt},
            #{item.updatedAt},
            #{item.deleted},
            #{item.tenantId},
            #{item.createdBy},
            #{item.updatedBy}
            )
        </foreach>
    </sql>

    <sql id="oracle_insert_batch">
        insert into flow_form(
        id,
        form_code,
        form_name,
        version,
        publish_status,
        form_content,
        ext,
        created_at,
        updated_at,
        deleted,
        tenant_id,
        created_by,
        updated_by
        )
        <foreach collection="list" item="item" separator=" union all">
            select
            #{item.id},
            #{item.formCode},
            #{item.formName},
            #{item.version},
            #{item.publishStatus},
            #{item.formContent},
            #{item.ext},
            #{item.createdAt},
            #{item.updatedAt},
            #{item.deleted},
            #{item.tenantId},
            #{item.createdBy},
            #{item.updatedBy}
            from dual
        </foreach>
    </sql>

<select id="selectList" parameterType="com.luokuiai.flovira.orm.entity.FlowForm"
            resultMap="FlowFormResult">
        <choose>
            <when test="dataSourceType == 'oracle'.toString()">
                <if test="page !=null and page.pageNum != null and page.pageSize != null">
                    SELECT * FROM ( SELECT TMP.*, ROWNUM ROW_ID FROM (
                </if>
                <include refid="includeAll"/>
                <if test="page !=null and page.pageNum != null and page.pageSize != null">
                    ) TMP WHERE ROWNUM &lt;= #{page.pageSize}) WHERE ROW_ID &gt; #{page.pageNum}
                </if>
            </when>
            <otherwise>
                <include refid="includeAll"/>
                <include refid="paging_end"/>
            </otherwise>
        </choose>
    </select>

    <sql id="includeAll">
        <include refid="selectVo"/>
        <include refid="select_parameter"/>
        <include refid="order_by"/>
    </sql>

<select id="selectCount" parameterType="com.luokuiai.flovira.orm.entity.FlowForm"
            resultType="java.lang.Long">
        select count(*) from flow_form t
        <include refid="select_parameter"/>
    </select>

    <select id="selectById" resultMap="FlowFormResult">
        <include refid="selectVo"/>
        where t.id = #{id}
        <if test="entity.deleted != null  and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null  and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
    </select>

    <select id="selectByIds" resultMap="FlowFormResult">
        <include refid="selectVo"/>
        where t.id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        <if test="entity.deleted != null  and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null  and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
    </select>

    <select id="queryByCodeList" resultMap="FlowFormResult">
        <include refid="selectVo"/>
        where t.form_code in
        <foreach item="item" collection="formCodeList" open="(" separator="," close=")">
            #{item}
        </foreach>
        <if test="entity.deleted != null  and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null  and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
    </select>

    <insert id="insert" parameterType="com.luokuiai.flovira.orm.entity.FlowForm">
        insert into flow_form
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="formCode != null and formCode != ''">form_code,</if>
            <if test="formName != null and formName != ''">form_name,</if>
            <if test="version != null and version != ''">version,</if>
            <if test="publishStatus != null">publish_status,</if>
            <if test="formContent != null and formContent != ''">form_content,</if>
            <if test="ext != null and ext != ''">ext,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="deleted != null and deleted != ''">deleted,</if>
            <if test="tenantId != null and tenantId != ''">tenant_id,</if>
            <if test="createdBy != null and createdBy != ''">created_by,</if>
            <if test="updatedBy != null and updatedBy != ''">updated_by,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="formCode != null and formCode != ''">#{formCode},</if>
            <if test="formName != null and formName != ''">#{formName},</if>
            <if test="version != null and version != ''">#{version},</if>
            <if test="publishStatus != null">#{publishStatus},</if>
            <if test="formContent != null">#{formContent},</if>
            <if test="ext != null and ext != ''">#{ext},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="deleted != null and deleted != ''">#{deleted},</if>
            <if test="tenantId != null and tenantId != ''">#{tenantId},</if>
            <if test="createdBy != null and createdBy != ''">#{createdBy},</if>
            <if test="updatedBy != null and updatedBy != ''">#{updatedBy}</if>
        </trim>
    </insert>

<update id="updateById" parameterType="com.luokuiai.flovira.orm.entity.FlowForm">
        update flow_form
        <trim prefix="SET" suffixOverrides=",">
            <if test="formCode != null and formCode != ''">form_code = #{formCode},</if>
            <if test="formName != null and formName != ''">form_name = #{formName},</if>
            <if test="version != null and version != ''">version = #{version},</if>
            <if test="publishStatus != null">publish_status = #{publishStatus},</if>
            <if test="formContent != null">form_content = #{formContent},</if>
            <if test="ext != null and ext != ''">ext = #{ext},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
        </trim>
        where id = #{id}
        <if test="deleted != null  and deleted != ''">and deleted = #{deleted}</if>
        <if test="tenantId != null  and tenantId != ''">and tenant_id = #{tenantId}</if>
    </update>

    <delete id="deleteById">
        delete
        from flow_form
        where id = #{id}
        <if test="entity.tenantId != null  and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
    </delete>

    <update id="updateByIdLogic">
        update flow_form
        set deleted = #{logicDeleteValue}
        where id = #{id}
        <if test="entity.tenantId != null  and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
        <if test="logicNotDeleteValue != null and logicNotDeleteValue != ''">and deleted = #{logicNotDeleteValue}
        </if>
    </update>

    <delete id="deleteByIds">
        delete from flow_form where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        <if test="entity.tenantId != null  and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
    </delete>

    <update id="updateByIdsLogic">
        update flow_form
        set deleted = #{logicDeleteValue}
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        <if test="entity.tenantId != null  and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
        <if test="logicNotDeleteValue != null and logicNotDeleteValue != ''">and deleted = #{logicNotDeleteValue}
        </if>
    </update>

<delete id="delete" parameterType="com.luokuiai.flovira.orm.entity.FlowForm">
        delete from flow_form
        <where>
            <if test="id != null">and id = #{id}</if>
            <if test="formCode != null and formCode != ''">and form_code = #{formCode}</if>
            <if test="formName != null and formName != ''">and form_name = #{formName}</if>
            <if test="version != null and version != ''">and version = #{version}</if>
            <if test="publishStatus != null">and publish_status = #{publishStatus}</if>
            <if test="formContent != null">and form_content = #{formContent}</if>
            <if test="ext != null and ext != ''">and ext = #{ext}</if>
            <if test="createdAt != null">and created_at = #{createdAt}</if>
            <if test="updatedAt != null">and updated_at = #{updatedAt}</if>
            <if test="tenantId != null and tenantId != ''">and tenant_id = #{tenantId}</if>
        </where>
    </delete>

    <update id="updateLogic">
        update flow_form
        set deleted = #{logicDeleteValue}
        <where>
            <if test="entity.id != null">and id = #{entity.id}</if>
            <if test="entity.formCode != null and entity.formCode != ''">and form_code = #{entity.formCode}</if>
            <if test="entity.formName != null and entity.formName != ''">and form_name = #{entity.formName}</if>
            <if test="entity.version != null and entity.version != ''">and version = #{entity.version}</if>
            <if test="entity.publishStatus != null">and publish_status = #{entity.publishStatus}</if>
            <if test="entity.formContent != null">and form_content = #{entity.formContent}</if>
            <if test="entity.ext != null and entity.ext != ''">and ext = #{entity.ext}</if>
            <if test="entity.createdAt != null">and created_at = #{entity.createdAt}</if>
            <if test="entity.updatedAt != null">and updated_at = #{entity.updatedAt}</if>
            <if test="entity.tenantId != null and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
            <if test="logicNotDeleteValue != null and logicNotDeleteValue != ''">and deleted =
                #{logicNotDeleteValue}
            </if>
        </where>
    </update>

<insert id="saveBatch" parameterType="com.luokuiai.flovira.orm.entity.FlowForm">
        <choose>
            <when test="dataSourceType == 'oracle'.toString()">
                <include refid="oracle_insert_batch"/>
            </when>
            <otherwise>
                <include refid="mysql_insert_batch"/>
            </otherwise>
        </choose>
    </insert>
</mapper>
