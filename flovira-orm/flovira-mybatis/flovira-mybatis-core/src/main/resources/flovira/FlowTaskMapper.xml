        <if test="deleted != null  and deleted != ''">and deleted = #{deleted}</if>
        <if test="tenantId != null  and tenantId != ''">and tenant_id = #{tenantId}</if>
    </update>

    <update id="claimPendingTimeout">
        update flow_task set timeout_status = 'RUNNING', timeout_claimed_at = #{claimedAt}
        where id = #{taskId} and timeout_status = 'PENDING'
        <if test="entity.deleted != null and entity.deleted != ''">and deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
    </update>

    <update id="claimStaleTimeout">
        update flow_task set timeout_status = 'RUNNING', timeout_claimed_at = #{claimedAt}
        where id = #{taskId} and timeout_status = 'RUNNING' and timeout_claimed_at &lt;= #{staleBefore}
        <if test="entity.deleted != null and entity.deleted != ''">and deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
    </update>

    <update id="claimWait">
        update flow_task set timeout_status = 'RUNNING', timeout_claimed_at = #{claimedAt}
        where id = #{taskId} and node_type = 7
        and (timeout_status is null or timeout_status = 'PENDING')
        <if test="entity.deleted != null and entity.deleted != ''">and deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
    </update>

    <update id="releaseTimeout">
        update flow_task set timeout_status = 'PENDING', timeout_claimed_at = null
        where id = #{taskId} and timeout_status = 'RUNNING'
        <if test="entity.deleted != null and entity.deleted != ''">and deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
    </update>

    <delete id="deleteById">
        delete
        from flow_task
        where id = #{id}
        <if test="entity.tenantId != null  and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
    </delete>

    <update id="updateByIdLogic">
        update flow_task
        set deleted = #{logicDeleteValue}
        where id = #{id}
        <if test="entity.tenantId != null  and entity.tenantId != ''">and tenant_id = #{entity.tenantId}</if>
        <if test="logicNotDeleteValue != null and logicNotDeleteValue != ''">and deleted = #{logicNotDeleteValue}
        </if>
    </update>

