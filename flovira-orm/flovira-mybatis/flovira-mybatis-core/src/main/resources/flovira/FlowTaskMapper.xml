        </foreach>
    </sql>

    <select id="selectCount" parameterType="com.luokuiai.flovira.orm.entity.FlowTask" resultType="java.lang.Long">
        select count(*) from flow_task t
        <include refid="select_parameter"/>
    </select>

    <select id="selectList" parameterType="com.luokuiai.flovira.orm.entity.FlowTask" resultMap="FlowTaskResult">
        <choose>
            <when test="dataSourceType == 'oracle'.toString()">
                <if test="page !=null and page.pageNum != null and page.pageSize != null">
                    SELECT * FROM ( SELECT TMP.*, ROWNUM ROW_ID FROM (
                </if>
                <include refid="includeAll"/>
                <if test="page !=null and page.pageNum != null and page.pageSize != null">
                    ) TMP WHERE ROWNUM &lt;= #{page.pageSize}) WHERE ROW_ID &gt; #{page.pageNum}
                </if>
            </when>
            <otherwise>
                <include refid="includeAll"/>
                <include refid="paging_end"/>
            </otherwise>
        </choose>
    </select>

    <sql id="includeAll">
        <include refid="selectVo"/>
        <include refid="select_parameter"/>
        <include refid="order_by"/>
    </sql>

    <select id="selectByIds" resultMap="FlowTaskResult">
        <include refid="selectVo"/>
        where t.id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        <if test="entity.deleted != null  and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null  and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
    </select>

    <select id="selectById" resultMap="FlowTaskResult">
        <include refid="selectVo"/>
        where t.id = #{id}
        <if test="entity.deleted != null  and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null  and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
    </select>

    <select id="getByInsIdAndNodeCodes" resultMap="FlowTaskResult">
        <include refid="selectVo"/>
        where t.instance_id = #{instanceId}
        AND t.node_code in
        <foreach item="nodeCode" collection="nodeCodes" open="(" separator="," close=")">
            #{nodeCode}
        </foreach>
        <if test="entity.deleted != null  and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null  and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
    </select>

    <select id="getByInsIdAndNodeType" resultMap="FlowTaskResult">
        <include refid="selectVo"/>
        where t.instance_id = #{instanceId}
        and t.node_type = #{nodeType}
        <if test="entity.deleted != null and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
    </select>

    <select id="listByInsIds" resultMap="FlowTaskResult">
        <include refid="selectVo"/>
        where t.instance_id in
        <foreach item="instanceId" collection="instanceIds" open="(" separator="," close=")">
            #{instanceId}
        </foreach>
        <if test="entity.deleted != null and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
    </select>

    <select id="listDueTimeoutTasks" resultMap="FlowTaskResult">
        <include refid="selectVo"/>
        where t.timeout_at &lt;= #{dueBefore}
        and (t.timeout_status = 'PENDING'
            or (t.timeout_status = 'RUNNING' and t.timeout_claimed_at &lt;= #{staleBefore}))
        <if test="entity.deleted != null and entity.deleted != ''">and t.deleted = #{entity.deleted}</if>
        <if test="entity.tenantId != null and entity.tenantId != ''">and t.tenant_id = #{entity.tenantId}</if>
        order by t.timeout_at asc, t.id asc
    </select>

    <insert id="insert" parameterType="com.luokuiai.flovira.orm.entity.FlowTask">
        insert into flow_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
