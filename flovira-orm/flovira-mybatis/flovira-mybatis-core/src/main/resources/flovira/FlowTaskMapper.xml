    <sql id="mysql_insert_batch">
        insert into flow_task(
        id,
        node_code,
        node_name,
        node_type,
        flow_status,
        definition_id,
        instance_id,
        form_custom,
        form_path,
        created_at,
        updated_at,
        deleted,
        tenant_id,
        created_by,
        updated_by
        ,timeout_at
        ,timeout_action
        ,timeout_config
        ,timeout_status
        ,timeout_claimed_at
        )
        values
        <foreach collection="list" item="item" separator=",">
            (
            #{item.id},
            #{item.nodeCode},
            #{item.nodeName},
            #{item.nodeType},
            #{item.flowStatus},
            #{item.definitionId},
            #{item.instanceId},
            #{item.formCustom},
            #{item.formPath},
            #{item.createdAt},
            #{item.updatedAt},
