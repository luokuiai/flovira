<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luokuiai.flovira.orm.mapper.FlowSubprocessEventMapper">
    <resultMap id="EventResult" type="com.luokuiai.flovira.orm.entity.FlowSubprocessEvent">
        <id property="id" column="id"/><result property="runId" column="run_id"/><result property="childId" column="child_id"/>
        <result property="parentInstanceId" column="parent_instance_id"/><result property="childInstanceId" column="child_instance_id"/>
        <result property="parentNodeCode" column="parent_node_code"/><result property="eventType" column="event_type"/>
        <result property="eventResult" column="event_result"/><result property="reason" column="reason"/>
        <result property="occurredAt" column="occurred_at"/><result property="tenantId" column="tenant_id"/>
        <result property="delFlag" column="del_flag"/><result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/><result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>
    <sql id="columns">id,run_id,child_id,parent_instance_id,child_instance_id,parent_node_code,event_type,event_result,
        reason,occurred_at,tenant_id,del_flag,create_time,update_time,create_by,update_by</sql>
    <insert id="insert">insert into flow_subprocess_event (<include refid="columns"/>) values
        (#{id},#{runId},#{childId},#{parentInstanceId},#{childInstanceId},#{parentNodeCode},#{eventType},#{eventResult},
        #{reason},#{occurredAt},#{tenantId},#{delFlag},#{createTime},#{updateTime},#{createBy},#{updateBy})</insert>
    <select id="listByRunId" resultMap="EventResult">select <include refid="columns"/> from flow_subprocess_event
        where run_id=#{runId} and del_flag='0'
        <choose><when test="tenantId != null">and tenant_id=#{tenantId}</when><otherwise>and tenant_id is null</otherwise></choose>
        order by occurred_at,id</select>
</mapper>
